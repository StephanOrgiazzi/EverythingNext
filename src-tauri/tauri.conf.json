{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Everything Modern",
  "version": "0.1.0",
  "identifier": "com.everythingmodern.app",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Everything Modern",
        "width": 1240,
        "height": 780,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#202020",
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "Everything64.dll"
    ],
    "shortDescription": "Everything search in a modern Windows 11 interface",
    "longDescription": "A fast, modern Windows client powered by the existing Everything index.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
